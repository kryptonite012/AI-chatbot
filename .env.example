# ─────────────────────────────────────────────────────────────
#  Copy this file to .env and fill in what you need.
#  Every key is optional: the app shows only the models you connect.
#  You can also paste keys later in the app (Settings → API keys).
# ─────────────────────────────────────────────────────────────

# App
APP_NAME="Sangam AI"
APP_TAGLINE="Every top AI. One conversation."
PORT=3000

# Protect a public deployment so strangers can't spend your credits.
APP_PASSWORD=

# Let visitors paste their own API keys in Settings (true/false).
ALLOW_CLIENT_KEYS=true

# Chat requests allowed per visitor per minute (0 = unlimited).
RATE_LIMIT_PER_MINUTE=60

# ── Cloud AI providers ───────────────────────────────────────
OPENAI_API_KEY=         # ChatGPT    https://platform.openai.com/api-keys
GEMINI_API_KEY=         # Gemini     https://aistudio.google.com/apikey        (free tier)
ANTHROPIC_API_KEY=      # Claude     https://console.anthropic.com/settings/keys
XAI_API_KEY=            # Grok       https://console.x.ai
DEEPSEEK_API_KEY=       # DeepSeek   https://platform.deepseek.com/api_keys
PERPLEXITY_API_KEY=     # Perplexity https://www.perplexity.ai/account/api/keys
GROQ_API_KEY=           # Groq       https://console.groq.com/keys             (free tier)
OPENROUTER_API_KEY=     # OpenRouter https://openrouter.ai/keys                (free models)

# ── Offline / local models ───────────────────────────────────
# Ollama runs models on your own machine: https://ollama.com
OLLAMA_BASE_URL=http://localhost:11434

# Any OpenAI-compatible server (LM Studio, vLLM, LocalAI, Together, Mistral...)
CUSTOM_NAME=
CUSTOM_BASE_URL=        # e.g. http://localhost:1234/v1 for LM Studio
CUSTOM_API_KEY=
CUSTOM_MODELS=          # comma separated, optional

# ── Optional tweaks ──────────────────────────────────────────
# Change the model list shown for a provider (comma separated, first = default):
# OPENAI_MODELS=gpt-5-mini,gpt-5,gpt-4.1
# GEMINI_MODELS=gemini-2.5-flash,gemini-2.5-pro
# Hide a provider completely:
# PERPLEXITY_ENABLED=false
# Point a provider at a proxy or gateway:
# OPENAI_BASE_URL=https://api.openai.com/v1
# Max time for one answer (milliseconds):
# REQUEST_TIMEOUT_MS=300000
